{
  "rewrites": [
    {
      "source": "/api/ml-callback",
      "destination": "/api/mercadolibre?accion=callback"
    },
    {
      "source": "/api/mp-callback",
      "destination": "/api/mercadopago?accion=callback"
    },
    {
      "source": "/api/afiliado",
      "destination": "/api/estado-cuenta?panel=afiliado"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/tienda?sitemap=1"
    },
    {
      "source": "/chat",
      "destination": "/asistente/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/api/tienda?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/chat",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/asistente/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/leer-factura.js": {
      "maxDuration": 30
    },
    "api/mercadopago.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/revisar-suscripciones",
      "schedule": "0 12 * * *"
    }
  ]
}
